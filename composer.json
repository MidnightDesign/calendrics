{
    "name": "midnight/calendrics",
    "description": "TC39 Temporal API for PHP — immutable dates, times, durations, and time zones with nanosecond precision",
    "type": "library",
    "keywords": [
        "temporal",
        "tc39",
        "datetime",
        "date",
        "time",
        "timezone",
        "calendar",
        "duration",
        "iso8601",
        "nanosecond"
    ],
    "homepage": "https://github.com/MidnightDesign/calendrics",
    "license": "MIT",
    "authors": [
        {
            "name": "Rudolph Gottesheim",
            "email": "r.gottesheim@midnight-design.at"
        }
    ],
    "support": {
        "issues": "https://github.com/MidnightDesign/calendrics/issues",
        "source": "https://github.com/MidnightDesign/calendrics"
    },
    "require": {
        "php": ">=8.4",
        "ext-intl": "*"
    },
    "require-dev": {
        "carthage-software/mago": "^1.15.3",
        "infection/infection": "^0.32 || ^0.34",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.0",
        "psalm/plugin-phpunit": "^0.19",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Calendrics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Calendrics\\Tests\\": "tests/",
            "Calendrics\\Tools\\": "tools/"
        }
    },
    "scripts": {
        "test": "phpunit tests/",
        "test-coverage": "phpunit tests/ --coverage-xml build/coverage/coverage-xml --log-junit build/coverage/junit.xml",
        "test262:transpile": [
            "node tools/transpile-test262.mjs tests/Test262/data",
            "mago format tests/Test262/scripts"
        ],
        "test262:sync": "bash tools/sync-test262.sh",
        "test262:build": "@test262:transpile",
        "test262:run": "phpunit --testsuite test262",
        "infection": "php -d memory_limit=512M vendor/bin/infection --threads=max",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "psalm": "psalm",
        "mago": [
            "mago lint",
            "mago analyze"
        ],
        "mago-format": "mago format",
        "mago-check": "mago format --check",
        "check": [
            "@phpstan",
            "@psalm",
            "@mago",
            "@mago-check",
            "@test-coverage",
            "infection --threads=max --coverage=build/coverage --skip-initial-tests --filter=src/Calendar.php,src/Duration.php,src/Instant.php,src/Now.php,src/PlainDate.php,src/PlainDateTime.php,src/PlainMonthDay.php,src/PlainTime.php,src/PlainYearMonth.php,src/ZonedDateTime.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
