rules:
    - Calendrics\Tools\PHPStan\NoMixedIntFloatArithmeticRule
    - Calendrics\Tools\PHPStan\PreferSprintfOverConcatRule

parameters:
    level: 9
    paths:
        - src
        - tests
    excludePaths:
        - tests/Test262/scripts
    stubFiles:
        - tools/phpstan-stubs/IntlTimeZone.stub
        - tools/phpstan-stubs/DateTimeZone.stub
