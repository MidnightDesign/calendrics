<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache">
    <!--
        These two suites are exhaustive: every test file belongs under
        tests/Porcelain or tests/Test262. There is deliberately no catch-all
        suite, so a test placed in a new top-level directory belongs to no
        suite and never runs, which is how that mistake is meant to surface.
    -->
    <testsuites>
        <testsuite name="porcelain">
            <directory>tests/Porcelain</directory>
        </testsuite>
        <testsuite name="test262">
            <directory>tests/Test262</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src/</directory>
        </include>
    </source>
</phpunit>
